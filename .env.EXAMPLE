# Copy this file to the installed profile as `.env`.
# Hermes keeps secrets in `.env` and settings in `config.yaml`. Never put API keys in config.yaml.
#
# Pick the provider you actually use. None of these are required by the Seagull distribution itself.

# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
# GOOGLE_API_KEY=
# HERMES_API_KEY=
